NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/ohf

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SEED_OWNER_EMAIL=owner@ourhopefoundation.org.au
SEED_OWNER_PASSWORD=ChangeMeOwner123!

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRODUCT_ID=prod_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ohf-media
S3_PUBLIC_BASE_URL=https://ohf-media.s3.ap-southeast-2.amazonaws.com
SES_FROM_EMAIL=hello@ourhopefoundation.org.au

# Dev: leave empty to skip Turnstile verification
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

REVALIDATE_SECRET=change-me-revalidate-secret
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
LOG_LEVEL=info

# Local media fallback when S3 is not configured
LOCAL_MEDIA_DIR=./uploads
LOCAL_MEDIA_PUBLIC_URL=http://localhost:4000/uploads
